# Ignore local caches / secrets; keep empty model placeholders trackable via .gitkeep
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.DS_Store
.cursor/

# Large training caches (regenerate with python -m app.data_pipeline)
app/data/*.parquet
app/data/*.csv

# NSO / EDLCare gensum archive is tracked (raw + processed) for deploy/demo reproducibility
# Regenerate with: python -m app.ingestion.fetch_historical

# Keep trained .pkl + metrics JSON tracked — required for Hugging Face Space deploy
# Do NOT ignore app/models/*.pkl or app/models/*.json